---
/**
 * Minimal inline-SVG icon component. Drop-in replacement for the subset of
 * `astro-icon@0.8` icons used in this project. `astro-icon@0.8` is
 * incompatible with Astro 6 (its `Props` re-export breaks the build), so we
 * inline the few icons we actually need here.
 */
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = "" } = Astro.props;
const common = "currentColor";
---

{
  name === "bi:chevron-left" && (
    <svg viewBox="0 0 16 16" class={className} fill={common} aria-hidden="true">
      <path
        fill-rule="evenodd"
        d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"
      />
    </svg>
  )
}
{
  name === "ion:logo-vercel" && (
    <svg viewBox="0 0 512 512" class={className} fill={common} aria-hidden="true">
      <path d="M256 48L496 464H16L256 48z" />
    </svg>
  )
}
{
  name === "mdi:github" && (
    <svg viewBox="0 0 24 24" class={className} fill={common} aria-hidden="true">
      <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.54-3.87-1.54-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.33.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.7 5.4-5.26 5.69.41.35.78 1.04.78 2.1v3.11c0 .31.21.68.8.56 4.56-1.52 7.85-5.83 7.85-10.91C23.5 5.65 18.35.5 12 .5z" />
    </svg>
  )
}
{
  name === "mdi:play" && (
    <svg viewBox="0 0 24 24" class={className} fill={common} aria-hidden="true">
      <path d="M8 5v14l11-7z" />
    </svg>
  )
}
{
  name === "tabler:dots" && (
    <svg viewBox="0 0 24 24" class={className} fill="none" stroke={common} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="5" cy="12" r="1" fill={common} />
      <circle cx="12" cy="12" r="1" fill={common} />
      <circle cx="19" cy="12" r="1" fill={common} />
    </svg>
  )
}
{
  name === "mdi:heart" && (
    <svg viewBox="0 0 24 24" class={className} fill={common} aria-hidden="true">
      <path d="M12 21s-7-4.5-9.5-9C.9 8.5 2.5 4 6.5 4c2 0 3.5 1 5.5 3 2-2 3.5-3 5.5-3 4 0 5.6 4.5 4 8-2.5 4.5-9.5 9-9.5 9z" />
    </svg>
  )
}
{
  name === "carbon:home" && (
    <svg viewBox="0 0 32 32" class={className} fill={common} aria-hidden="true">
      <path d="M16.612 2.214a1 1 0 0 0-1.225 0L1 13.419l1.225 1.572L4 13.621V26a2 2 0 0 0 2 2h7v-7h6v7h7a2 2 0 0 0 2-2V13.63L29.775 15L31 13.419z" />
    </svg>
  )
}
{
  name === "carbon:search" && (
    <svg viewBox="0 0 32 32" class={className} fill={common} aria-hidden="true">
      <path d="M29 27.586l-7.552-7.552a11.018 11.018 0 1 0-1.414 1.414L27.586 29zM4 13a9 9 0 1 1 9 9a9.01 9.01 0 0 1-9-9z" />
    </svg>
  )
}
{
  name === "carbon:media-library" && (
    <svg viewBox="0 0 32 32" class={className} fill={common} aria-hidden="true">
      <path d="M27 4H11a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm-9 14V10l6 4z" />
      <path d="M5 30a2 2 0 0 1-2-2V8h2v20h20v2z" />
    </svg>
  )
}
{
  name === "carbon:time" && (
    <svg viewBox="0 0 32 32" class={className} fill={common} aria-hidden="true">
      <path d="M16 30a14 14 0 1 1 14-14a14 14 0 0 1-14 14zm0-26a12 12 0 1 0 12 12A12 12 0 0 0 16 4z" />
      <path d="M20.59 22L15 16.41V7h2v8.58l5 5.01z" />
    </svg>
  )
}
